<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SauceDemo_Automation_Complete_Suite" parallel="classes" thread-count="3" allow-return-values="true" preserve-order="true">

	<!-- ============================================ -->
	<!-- GLOBAL SUITE PARAMETERS                      -->
	<!-- ============================================ -->
	
	<!-- Configuration and Logging -->
	<parameter name="configurationFilesDirectory" value="./src/main/resources/config" />
	<parameter name="pathForSavingLogs" value="./logs" />
	<parameter name="logName" value="SAUCEDEMO_LOGS"/> 
	
	<!-- Application Parameters -->
	<parameter name="baseUrl" value="https://www.saucedemo.com/" />
	<parameter name="browser" value="chrome" />
	
	<!-- Wait and Timeout Parameters -->
	<parameter name="pollingTimeForWaitUntil" value="2" />
	<parameter name="implicitWait" value="10" />
	<parameter name="explicitWait" value="10" />
	<parameter name="maxWaitTime" value="60" />
	
	<!-- Screenshot Configuration -->
	<parameter name="captureScreenshot" value="true" />
	<parameter name="screenshotPath" value="./screenshots" />
	
	<!-- Test Data Reporting -->
	<listeners>
		<listener class-name="com.saucedemo.automation.utils.TestDataReportListener"/>
	</listeners>

	<!-- ============================================ -->
	<!-- LOGIN TESTS                                  -->
	<!-- ============================================ -->
	
	<!-- Test: Successful Login with Valid Credentials -->
	<test name="Login_ValidCredentials"> 
		<parameter name="testCode" value="./src/main/resources/testdata/LoginData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/LoginData.xlsx:LoginTests"/> 
		<parameter name="testDataSets" value="TC1" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.LoginTests">
				<methods>					
					<include name="testSuccessfulLogin" />					
				</methods>
			</class>
		</classes>   
	</test>	
	
	<!-- Test: Login with Invalid Username -->
	<test name="Login_InvalidUsername"> 
		<parameter name="testCode" value="./src/main/resources/testdata/LoginData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/LoginData.xlsx:LoginTests"/> 
		<parameter name="testDataSets" value="TC2" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.LoginTests">
				<methods>					
					<include name="testLoginWithInvalidUsername" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: Login with Invalid Password -->
	<test name="Login_InvalidPassword"> 
		<parameter name="testCode" value="./src/main/resources/testdata/LoginData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/LoginData.xlsx:LoginTests"/> 
		<parameter name="testDataSets" value="TC3" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.LoginTests">
				<methods>					
					<include name="testLoginWithInvalidPassword" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: Login with Empty Credentials -->
	<test name="Login_EmptyCredentials"> 
		<parameter name="testCode" value="./src/main/resources/testdata/LoginData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/LoginData.xlsx:LoginTests"/> 
		<parameter name="testDataSets" value="TC4" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.LoginTests">
				<methods>					
					<include name="testLoginWithEmptyCredentials" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: Login with Locked Out User -->
	<test name="Login_LockedOutUser"> 
		<parameter name="testCode" value="./src/main/resources/testdata/LoginData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/LoginData.xlsx:LoginTests"/> 
		<parameter name="testDataSets" value="TC5" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.LoginTests">
				<methods>					
					<include name="testLoginWithLockedOutUser" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: All Login Tests (Data-Driven) -->
	<test name="Login_AllTests_DataDriven"> 
		<parameter name="testCode" value="./src/main/resources/testdata/LoginData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/LoginData.xlsx:LoginTests"/> 
		<parameter name="testDataSets" value="ALL" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.LoginTests">
				<methods>					
					<include name="testSuccessfulLogin" />
					<include name="testLoginWithInvalidUsername" />
					<include name="testLoginWithInvalidPassword" />
					<include name="testLoginWithEmptyCredentials" />
					<include name="testLoginWithLockedOutUser" />					
				</methods>
			</class>
		</classes>   
	</test>

	<!-- ============================================ -->
	<!-- CART TESTS                                   -->
	<!-- ============================================ -->
	
	<!-- Test: Add Item to Cart -->
	<test name="Cart_AddItem"> 
		<parameter name="testCode" value="./src/main/resources/testdata/CartData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/CartData.xlsx:CartTests"/> 
		<parameter name="testDataSets" value="TC1" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.CartTests">
				<methods>					
					<include name="testAddItemToCart" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: Remove Item from Cart -->
	<test name="Cart_RemoveItem"> 
		<parameter name="testCode" value="./src/main/resources/testdata/CartData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/CartData.xlsx:CartTests"/> 
		<parameter name="testDataSets" value="TC2" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.CartTests">
				<methods>					
					<include name="testRemoveItemFromCart" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: Verify Cart Item Count -->
	<test name="Cart_VerifyItemCount"> 
		<parameter name="testCode" value="./src/main/resources/testdata/CartData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/CartData.xlsx:CartTests"/> 
		<parameter name="testDataSets" value="TC3" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.CartTests">
				<methods>					
					<include name="testCartItemCount" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: All Cart Tests (Data-Driven) -->
	<test name="Cart_AllTests_DataDriven"> 
		<parameter name="testCode" value="./src/main/resources/testdata/CartData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/CartData.xlsx:CartTests"/> 
		<parameter name="testDataSets" value="ALL" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.CartTests">
				<!-- Includes all cart test methods -->
			</class>
		</classes>   
	</test>

	<!-- ============================================ -->
	<!-- CHECKOUT TESTS                               -->
	<!-- ============================================ -->
	
	<!-- Test: Complete Checkout with Valid Information -->
	<test name="Checkout_ValidInformation"> 
		<parameter name="testCode" value="./src/main/resources/testdata/CheckoutData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/CheckoutData.xlsx:CheckoutTests"/> 
		<parameter name="testDataSets" value="TC1" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.CheckoutTests">
				<methods>					
					<include name="testCompleteCheckout" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: Checkout with Missing Information -->
	<test name="Checkout_MissingInformation"> 
		<parameter name="testCode" value="./src/main/resources/testdata/CheckoutData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/CheckoutData.xlsx:CheckoutTests"/> 
		<parameter name="testDataSets" value="TC2,TC3,TC4" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.CheckoutTests">
				<methods>					
					<include name="testCheckoutWithMissingFields" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: All Checkout Tests (Data-Driven) -->
	<test name="Checkout_AllTests_DataDriven"> 
		<parameter name="testCode" value="./src/main/resources/testdata/CheckoutData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/CheckoutData.xlsx:CheckoutTests"/> 
		<parameter name="testDataSets" value="ALL" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.CheckoutTests">
				<!-- Includes all checkout test methods -->
			</class>
		</classes>   
	</test>

	<!-- ============================================ -->
	<!-- END-TO-END TESTS                             -->
	<!-- ============================================ -->
	
	<!-- Test: Complete E2E Flow - Login to Order Complete -->
	<test name="E2E_CompleteFlow"> 
		<parameter name="testCode" value="./src/main/resources/testdata/EndToEndData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/EndToEndData.xlsx:EndToEndTests"/> 
		<parameter name="testDataSets" value="TC1" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.EndToEndTests">
				<methods>					
					<include name="testCompleteEndToEndFlow" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: E2E Flow with Multiple Products -->
	<test name="E2E_MultipleProducts"> 
		<parameter name="testCode" value="./src/main/resources/testdata/EndToEndData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/EndToEndData.xlsx:EndToEndTests"/> 
		<parameter name="testDataSets" value="TC2" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.EndToEndTests">
				<methods>					
					<include name="testE2EWithMultipleProducts" />					
				</methods>
			</class>
		</classes>   
	</test>
	
	<!-- Test: All End-to-End Tests (Data-Driven) -->
	<test name="E2E_AllTests_DataDriven"> 
		<parameter name="testCode" value="./src/main/resources/testdata/EndToEndData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/EndToEndData.xlsx:EndToEndTests"/> 
		<parameter name="testDataSets" value="ALL" /> 
		<classes>
			<class name="com.saucedemo.automation.tests.EndToEndTests">
				<!-- Includes all end-to-end test methods -->
			</class>
		</classes>   
	</test>

	<!-- ============================================ -->
	<!-- SMOKE TEST SUITE                             -->	<!-- Quick validation of critical functionality -->
	<!-- ============================================ -->
	
	<test name="SmokeTest_CriticalPath"> 
		<parameter name="testCode" value="./src/main/resources/testdata/LoginData.xlsx:TEST_CODE" />     
		<parameter name="testData" value="./src/main/resources/testdata/EndToEndData.xlsx:EndToEndTests"/> 
		<parameter name="testDataSets" value="TC1" /> 
		<classes>
			<!-- Login Test -->
			<class name="com.saucedemo.automation.tests.LoginTests">
				<methods>					
					<include name="testSuccessfulLogin" />					
				</methods>
			</class>
			<!-- E2E Test -->
			<class name="com.saucedemo.automation.tests.EndToEndTests">
				<methods>					
					<include name="testCompleteEndToEndFlow" />					
				</methods>
			</class>
		</classes>   
	</test>

</suite>
